{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jk-com-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// TODO: rename to something site-specific (can't be renamed in the dashboard)
			"database_name": "my-emdash-site",
			"database_id": "5827ccef-aa34-4e3e-ae4b-620858c49d9c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// TODO: rename to something site-specific
			"bucket_name": "my-emdash-media",
			"preview_bucket_name": "my-emdash-media",
		},
	],
	// Co-editing rooms
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Scheduled publishing, backups, maintenance
	"triggers": {
		"crons": ["* * * * *"],
	},
}
