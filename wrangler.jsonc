{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jk-com-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// TODO: rename to something site-specific (can't be renamed in the dashboard)
			"database_name": "my-emdash-site",
			"database_id": "5827ccef-aa34-4e3e-ae4b-620858c49d9c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			// TODO: rename to something site-specific
			"bucket_name": "my-emdash-media",
			"preview_bucket_name": "my-emdash-media",
		},
	],
	// Astro session store (@astrojs/cloudflare adds a SESSION binding automatically). Pin the id:
	// `wrangler preview` (branch builds) doesn't auto-provision KV and fails with error 10021
	// without it; the production deploy already uses this namespace.
	"kv_namespaces": [{ "binding": "SESSION", "id": "572a7a1bf0ef4f03b617f73f20dca857" }],
	// `wrangler preview` reads bindings from `previews`; the adapter adds SESSION there without an id.
	"previews": {
		"kv_namespaces": [{ "binding": "SESSION", "id": "572a7a1bf0ef4f03b617f73f20dca857" }],
	},
	// Co-editing rooms
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Outbound email (magic links, invites) via Cloudflare Email Service
	"send_email": [{ "name": "EMAIL" }],
	// Sandboxed plugins run as Dynamic Workers via Worker Loader (Workers Paid)
	"worker_loaders": [{ "binding": "LOADER" }],
	// AI Search plugin; Wrangler creates the namespace on first deploy if missing
	"ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "default" }],
	// Scheduled publishing, backups, maintenance
	"triggers": {
		"crons": ["* * * * *"],
	},
}
