---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { chipsFor } from "../../utils/chips";
import { getReadingTime } from "../../utils/reading-time";
import Pagination from "../../components/Pagination.astro";
import { PAGE_SIZE, pageFromUrl, pageOffset } from "../../utils/pagination";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug, { includeCounts: true }) : null;

if (!term) {
	return Astro.redirect("/404");
}

const page = pageFromUrl(Astro.url);
const { entries: posts, hasMore, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	offset: pageOffset(page),
});

// A page past the end is a 404, not an empty list.
if (page > 1 && posts.length === 0) return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags on every post tagged with this term,
// rather than calling getEntryTerms() per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);
// Term counts cover the whole archive; the page only holds one slice of it.
const postCount = term.count ?? posts.length;
const filteredPosts = posts.map((post) => ({
	post,
	tags: chipsFor(tagsByEntry.get(post.data.id), categoriesByEntry.get(post.data.id)),
}));
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`${postCount} ${postCount === 1 ? "post" : "posts"} tagged ${term.label} on Jayson Knight's blog about software architecture and development.`}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Tag</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{postCount} {postCount === 1 ? "post" : "posts"}
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">No posts with this tag yet.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags}
						/>
					))}
				</div>
			)
		}
		<Pagination basePath={`/tag/${term.slug}`} page={page} hasMore={hasMore ?? false} />
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
