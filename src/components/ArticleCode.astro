---
// Portable Text `code` renderer. Owns the markup so it can use Phosphorous tokens
// (EmDash's default Code component hard-codes its colors). Mermaid blocks become diagrams.
interface Props {
	node: { _type: "code"; _key: string; code: string; language?: string; filename?: string };
}

const { node } = Astro.props;
const isMermaid = node.language === "mermaid";
const languageClass = node.language ? `language-${node.language}` : undefined;
---

{
	isMermaid ? (
		<figure class="mermaid-figure">
			<pre class="mermaid">{node.code}</pre>
		</figure>
	) : (
		node.code && (
			<div class="article-code">
				{node.filename && <div class="article-code-filename">{node.filename}</div>}
				{/* No whitespace between <pre> and <code>: it would render as a blank first line. */}
				<pre class={languageClass}><code class={languageClass}>{node.code}</code></pre>
			</div>
		)
	)
}

<style is:global>
	.article-content .article-code {
		margin: 1.75rem 0;
	}

	.article-content .article-code-filename {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-mono);
		color: var(--color-text-dim);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-bottom: 0;
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
		padding: var(--spacing-2) var(--spacing-4);
	}

	/* div.article-code (not just .article-code) so these beat the page's own `.article-content pre` rule. */
	.article-content div.article-code pre {
		margin: 0;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-align: left;
	}

	.article-content div.article-code .article-code-filename + pre {
		border-radius: 0 0 var(--radius-lg) var(--radius-lg);
	}

	.article-content div.article-code pre code {
		color: var(--color-text);
		background: none;
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.article-content figure.mermaid-figure {
		margin: 2em 0;
	}

	.article-content figure.mermaid-figure pre.mermaid {
		background: none;
		border: 0;
		padding: 0;
		text-align: center;
		font-family: var(--font-body);
		overflow-x: auto;
	}
</style>

<script>
	// Load mermaid only on pages that have a diagram. Until it runs, the diagram source stays readable.
	const nodes = Array.from(document.querySelectorAll<HTMLElement>("pre.mermaid"));
	if (nodes.length) {
		const { default: mermaid } = await import("mermaid");
		// Mermaid measures label text when it renders; wait for webfonts so boxes aren't sized for a fallback font.
		await document.fonts.ready;
		mermaid.initialize({
			startOnLoad: false,
			theme: "dark",
			securityLevel: "strict",
			fontFamily: '"Space Grotesk", system-ui, sans-serif',
			themeVariables: { primaryColor: "#0d1117", primaryBorderColor: "#00d4ff", lineColor: "#94a3b8", primaryTextColor: "#e2e8f0" },
		});
		await mermaid.run({ nodes });
	}
</script>
